#version 460 core
#extension GL_ARB_separate_shader_objects : enable

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba8)
uniform readonly image2D prevFrame;

layout(set = 0, binding = 1, rgba8)
uniform readonly image2D nextFrame;

layout(set = 0, binding = 2, rgba8)
uniform writeonly image2D outputFrame;

const int SEARCH_RADIUS = 3;
const int BLOCK_RADIUS  = 1;

// Luminance is cheaper than comparing RGB.
float luma(vec4 c)
{
    return dot(c.rgb, vec3(0.299, 0.587, 0.114));
}

// Compare a small 3x3 block around a pixel.
float blockError(
    ivec2 center,
    ivec2 offset,
    ivec2 size)
{
    float error = 0.0;

    for (int y = -BLOCK_RADIUS; y <= BLOCK_RADIUS; ++y)
    {
        for (int x = -BLOCK_RADIUS; x <= BLOCK_RADIUS; ++x)
        {
            ivec2 aPos = clamp(
                center + ivec2(x, y),
                ivec2(0),
                size - ivec2(1)
            );

            ivec2 bPos = clamp(
                center + offset + ivec2(x, y),
                ivec2(0),
                size - ivec2(1)
            );

            float a = luma(imageLoad(prevFrame, aPos));
            float b = luma(imageLoad(nextFrame, bPos));

            error += abs(a - b);
        }
    }

    return error;
}

// Estimate motion using block matching.
vec2 estimateMotion(ivec2 p, ivec2 size)
{
    float bestError = 1e20;
    ivec2 bestMotion = ivec2(0);

    for (int y = -SEARCH_RADIUS; y <= SEARCH_RADIUS; ++y)
    {
        for (int x = -SEARCH_RADIUS; x <= SEARCH_RADIUS; ++x)
        {
            ivec2 motion = ivec2(x, y);

            float error = blockError(
                p,
                motion,
                size
            );

            if (error < bestError)
            {
                bestError = error;
                bestMotion = motion;
            }
        }
    }

    return vec2(bestMotion);
}

// Sample an image using normalized coordinates.
vec4 sampleImage(
    image2D img,
    vec2 position,
    ivec2 size)
{
    ivec2 p = clamp(
        ivec2(round(position)),
        ivec2(0),
        size - ivec2(1)
    );

    return imageLoad(img, p);
}

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputFrame);

    if (p.x >= size.x || p.y >= size.y)
        return;

    // Estimate motion
    vec2 motion = estimateMotion(p, size);

    // Confidence estimation
    float centerError =
        blockError(p, ivec2(0), size);

    float motionError =
        blockError(p, ivec2(motion), size);

    float confidence =
        1.0 - clamp(
            motionError /
            max(centerError, 0.0001),
            0.0,
            1.0
        );

    // Avoid trusting extremely weak motion estimates.
    confidence = smoothstep(
        0.05,
        0.35,
        confidence
    );

    // Reproject both frames toward the halfway point
    vec2 halfMotion = motion * 0.5;

    vec2 prevPosition =
        vec2(p) + halfMotion;

    vec2 nextPosition =
        vec2(p) - halfMotion;

    vec4 prevPixel =
        sampleImage(
            prevFrame,
            prevPosition,
            size
        );

    vec4 nextPixel =
        sampleImage(
            nextFrame,
            nextPosition,
            size
        );

    // Motion-compensated interpolation
    vec4 generated =
        mix(
            prevPixel,
            nextPixel,
            0.5
        );

    // Fallback for unreliable motion
    vec4 originalBlend =
        mix(
            imageLoad(prevFrame, p),
            imageLoad(nextFrame, p),
            0.5
        );

    generated =
        mix(
            originalBlend,
            generated,
            confidence
        );

    generated.a = 1.0;

    imageStore(
        outputFrame,
        p,
        generated
    );
}
